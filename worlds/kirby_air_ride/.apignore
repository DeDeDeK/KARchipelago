# World-specific ignore patterns, appended to data/GLOBAL.apignore.
# Tool caches that should never ship in the built .apworld.
.ruff_cache
.pytest_cache
.mypy_cache

# Dev-only. Nothing in the world imports these, and AP's own suite collects tests
# from the source tree (pytest.ini testpaths), never from a packaged .apworld.
/test/
/fuzz/
/ruff.toml

/assets/karchipelago-logo.png
